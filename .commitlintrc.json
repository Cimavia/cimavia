{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "body-max-line-length": [0],
    "footer-max-line-length": [0],
    "subject-case": [2, "always", "lower-case"],
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "chore", "docs", "refactor", "test", "perf", "ci", "revert"]
    ]
  }
}
