# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Turbo
.turbo/
.tanstack/

# Environment
.env
.env.*
!.env.example
# Le modèle du .env.test des e2e : que des conteneurs jetables, aucun secret. Versionné pour que
# la CI le copie sans qu'un identifiant entre dans le workflow — et qu'un clone frais puisse
# lancer les e2e, qui sont la seule couverture de la couche API.
!.env.test.example

# Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Expo
.expo/
android/
ios/

# Couverture de tests (régénérée à chaque `pnpm test`, lue par SonarCloud en CI)
coverage/
# Couverture des e2e — répertoire distinct, sinon les deux rapports s'effacent l'un l'autre.
coverage-e2e/
# Mutation testing (#626) : rapports et cache incrémental régénérés à chaque run, et le bac à
# sable où Stryker copie le paquet — il y reste si un run est interrompu.
**/reports/mutation/
.stryker-tmp/
# E2e navigateur (#627) : le rapport HTML et les traces des échecs, régénérés à chaque run.
playwright-report/
test-results/

# Prisma
prisma/migrations/.gitkeep

*Zone.Identifier
# Claude Code : les permissions accordées sur ce poste, réécrites par l'outil à chaque accord. Ignoré
# ici et pas seulement dans l'ignore global : Biome ne lit que celui du dépôt, et `biome ci .` (porte
# qualité, hook de fin de réponse) échouait sur un fichier que personne n'édite.
.claude/settings.local.json
