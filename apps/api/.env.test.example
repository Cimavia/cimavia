# Modèle du .env.test des e2e. À copier tel quel, sans rien renseigner :
#
#   cp apps/api/.env.test.example apps/api/.env.test
#
# Contrairement à .env.example, ce fichier n'a AUCUN trou à remplir. Il décrit des conteneurs
# jetables (docker-compose.test.yml + le MinIO de docker-compose.yml), pas un environnement :
# les identifiants ci-dessous n'ouvrent rien qui n'existe que le temps d'une suite de tests.
# C'est ce qui permet à la CI de le copier sans qu'aucun secret n'entre dans le workflow.
#
# vitest.config.e2e.ts charge ce fichier par `process.loadEnvFile` — qui LÈVE s'il est absent.
# Ne pas rendre ce chargement tolérant : c'est lui qui empêche la suite de démarrer sur un
# DATABASE_URL hérité du shell. La suite TRUNCATE toutes les tables à l'ouverture.

# Server
PORT=3001
NODE_ENV=test

# Database — base e2e JETABLE (docker-compose.test.yml, port 5434). Jamais celle de dev, jamais
# Neon : global-setup.e2e.ts refuse de démarrer si le nom de base ne finit pas par `_e2e`.
DATABASE_URL="postgresql://cimavia_e2e:cimavia_dev_e2e@localhost:5434/cimavia_db_e2e"

# Auth
BETTER_AUTH_SECRET=test-secret-not-for-production-0123456789abcdef
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:8081 # Metro Expo dev server

# Object storage : les S3_* ne sont PAS ici — vitest.config.e2e.ts les fixe lui-même sur le MinIO
# de docker-compose.yml (bucket `cimavia-media-e2e`), pour que le flux médias de P4 (URL signée →
# PUT direct → rattachement → purge) soit testé contre un vrai storage et non contre le .env local.
