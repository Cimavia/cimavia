{
  // Les e2e ne peuvent pas entrer dans l'`include` de tsconfig.json : celui-ci compile en
  // CommonJS (cible Nest), or `global-setup.e2e.ts` utilise `import.meta.url` — TS1343. Ce
  // n'est pas un détail de config, c'est une différence de runtime réelle : ces fichiers ne
  // sont jamais chargés par Node, mais transformés en ESM par Vitest. On les typecheck donc
  // dans le module system où ils s'exécutent VRAIMENT, sinon on vérifierait le mauvais code.
  //
  // `src` est tiré transitivement par les imports du spec (AppModule, configureApp, Prisma) :
  // c'est voulu — c'est ce qui fait qu'un DTO renommé casse ici au lieu de passer en silence.
  "extends": "@cmv/tsconfig/nestjs",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["test", "vitest.config.e2e.ts"],
  "exclude": ["node_modules", "dist"]
}
