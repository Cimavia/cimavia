    "@axiomhq/pino": "^1.7.0",
    "@better-auth/expo": "1.7.6",
    "@cmv/shared": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.5",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-fastify": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/nestjs": "10.61.0",
    "@sentry/profiling-node": "10.61.0",
    "@thallesp/nestjs-better-auth": "2.8.0",
