{
  "name": "@cmv/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run --passWithNoTests --coverage",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.config.e2e.ts --coverage",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@axiomhq/pino": "^2.0.0",
    "@better-auth/expo": "1.7.12",
    "@cmv/shared": "workspace:*",
    "@fastify/static": "10.1.6",
    "@nestjs/common": "12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-fastify": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@sentry/nestjs": "11.8.0",
    "@sentry/profiling-node": "11.8.0",
    "@thallesp/nestjs-better-auth": "2.8.0",
    "better-auth": "1.7.12",
    "expo-server-sdk": "^6.1.0",
    "nestjs-cls": "7.0.1",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.1.7",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cmv/e2e": "workspace:*",
    "@cmv/tsconfig": "workspace:*",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "12.2.0",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.20.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.11",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
