    "expo-server-sdk": "^6.1.0",
    "nestjs-cls": "6.2.1",
    "nestjs-pino": "4.6.1",
    "nodemailer": "9.1.1",
    "pg": "8.23.0",
    "pino": "^10.3.1",
    "pino-http": "11.0.0",
    "prisma": "7.10.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
