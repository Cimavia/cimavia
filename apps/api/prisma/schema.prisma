generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth — tables gérées par Better Auth (voir apps/api/src/auth/…).
// Le `User` porte le profil via *additionalFields* Better Auth : `role` et `locale`
// sont des scalaires (String) validés côté app par @cmv/shared (Role, Locale) —
// pas des enums Postgres, car Better Auth ne gère que des types scalaires.
// Optionnel : `npx @better-auth/cli generate` peut resynchroniser ces modèles.
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  // additionalFields Better Auth (validés par @cmv/shared) :
  role          String // Role : COACH | ATHLETE | ADMIN
  locale        String   @default("fr") // Locale : fr | en
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Auth
  sessions AuthSession[]
  accounts Account[]

  // Métier — tenancy (relation coach↔athlète nullable/réversible)
  athleteRelation     CoachAthlete?  @relation("AthleteRelation") // athlète → au plus 1 coach
  coachRelations      CoachAthlete[] @relation("CoachRelations") // coach → N athlètes
  coachInvitations    Invitation[]   @relation("CoachInvitations")
  acceptedInvitations Invitation[]   @relation("AthleteAcceptedInvitations")
  athleteSheet        AthleteSheet?  @relation("AthleteSheetAthlete") // fiche de l'athlète
  coachSheets         AthleteSheet[] @relation("AthleteSheetCoach") // fiches rédigées par le coach

  // Métier — bibliothèque du coach (P2)
  exercises     Exercise[]     @relation("CoachExercises") // exercices du coach
  coachSessions Session[]      @relation("CoachSessions") // séances (modèles) du coach
  customMetrics CustomMetric[] @relation("CoachMetrics") // métriques et échelles maison

  // Métier — planifications (P3) : premier objet lu par les DEUX rôles.
  coachPlans   Plan[] @relation("CoachPlans") // planifs écrites par le coach
  athletePlans Plan[] @relation("AthletePlans") // planifs reçues par l'athlète

  // Métier — débriefs (P4) : écrits par l'athlète, lus par le coach.
  athleteFeedback SessionFeedback[] @relation("AthleteFeedback")
  coachFeedback   SessionFeedback[] @relation("CoachFeedback")

  // Métier — messagerie (P5) : fil 1:1 lu et écrit par les DEUX rôles.
  coachConversations   Conversation[] @relation("CoachConversations")
  athleteConversations Conversation[] @relation("AthleteConversations")
  sentMessages         Message[]      @relation("SentMessages")

  // Notifications push — les DEUX rôles enregistrent leurs appareils (P4).
  pushTokens PushToken[]

  // Centre de notifications (#48) : la trace PERSISTÉE des mêmes événements que le push.
  notifications Notification[] @relation("ReceivedNotifications")

  // Métier — facturation (P6) : émises par le coach, lues par l'athlète.
  coachInvoices   Invoice[] @relation("CoachInvoices")
  athleteInvoices Invoice[] @relation("AthleteInvoices")

  // Rappels (#44) : outil PRIVÉ du coach — aucune relation côté athlète, il n'en voit jamais aucun.
  coachReminders Reminder[] @relation("CoachReminders")

  @@map("user")
}

// Renommé `AuthSession` (table `session` conservée via @@map) pour libérer `Session` au
// profit de l'entité métier séance (P2). Résolu par Better Auth via `session.modelName`.
model AuthSession {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────────────────────
// Métier — fondation multi-tenant (P1).
// Invariant : 1 athlète a AU PLUS 1 coach (0 ou 1, unicité en base) ; 1 coach = N athlètes.
// La relation est une table à part : absence de ligne = athlète autonome (v1.0) ;
// suppression = redevient autonome. Réversible par construction, sans refonte.
// ─────────────────────────────────────────────────────────────────────────────

enum CoachAthleteStatus {
  PENDING
  ACTIVE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model CoachAthlete {
  id        String             @id @default(cuid())
  coachId   String
  coach     User               @relation("CoachRelations", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId String             @unique // unicité → au plus 1 coach par athlète
  athlete   User               @relation("AthleteRelation", fields: [athleteId], references: [id], onDelete: Cascade)
  status    CoachAthleteStatus @default(ACTIVE)
  invitedAt DateTime           @default(now())
  joinedAt  DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([coachId])
  @@map("coach_athlete")
}

model Invitation {
  id                  String           @id @default(cuid())
  code                String           @unique
  email               String? // nominative si présent ; sinon lien générique
  status              InvitationStatus @default(PENDING)
  coachId             String
  coach               User             @relation("CoachInvitations", fields: [coachId], references: [id], onDelete: Cascade)
  acceptedByAthleteId String?
  acceptedByAthlete   User?            @relation("AthleteAcceptedInvitations", fields: [acceptedByAthleteId], references: [id], onDelete: SetNull)
  expiresAt           DateTime
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([coachId])
  @@map("coach_invitation")
}

model AthleteSheet {
  id        String   @id @default(cuid())
  athleteId String   @unique // une fiche par athlète
  athlete   User     @relation("AthleteSheetAthlete", fields: [athleteId], references: [id], onDelete: Cascade)
  coachId   String
  coach     User     @relation("AthleteSheetCoach", fields: [coachId], references: [id], onDelete: Cascade)
  content   String   @default("") // champ libre, éditable par le coach seul (tenancy layer)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([coachId])
  @@map("athlete_sheet")
}

// ─────────────────────────────────────────────────────────────────────────────
// Métier — bibliothèque du coach (P2).
// Exercices et séances (modèles) réutilisables, scopés au coach (coachId).
// Le `coachId` est dénormalisé sur les tables enfant (ExerciseDocument,
// SessionExercise) : le tenancy extension scope chaque modèle par un champ DIRECT,
// donc toute entité métier porte son propre champ tenant (règle dure multi-tenant).
// ─────────────────────────────────────────────────────────────────────────────

/// Nature de la valeur portée par une colonne. SCALE désigne une échelle ORDONNÉE : ses paliers
/// se comparent, ce qu'un simple texte ne permet pas.
enum MetricValueType {
  NUMBER
  DURATION
  TEXT
  SCALE
}

/// À quoi sert un document rattaché à un exercice. Sans lui, une image POSÉE dans la consigne
/// réapparaîtrait dans la liste des pièces jointes — visible deux fois, supprimable d'un côté
/// sans que le coach comprenne pourquoi elle disparaît de l'autre.
enum DocumentUsage {
  ATTACHMENT
  INSTRUCTION
}

enum DocumentType {
  FILE // fichier uploadé en object storage (storagePath)
  LINK // lien externe (url) — ex. vidéo YouTube
}

model Exercise {
  id          String   @id @default(cuid())
  coachId     String
  coach       User     @relation("CoachExercises", fields: [coachId], references: [id], onDelete: Cascade)
  title       String
  description String? // consignes — nullable, pas de fallback (règle dure n°5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Consigne structurée (`RichDocument` de @cmv/shared) qui remplace `description`. Les deux
  /// cohabitent le temps que le constructeur web bascule (#163) : phase *expand* de
  /// expand/migrate/contract. `description` tombe au *contract*.
  instructions Json?
  /// Blocs de structure ordonnés (`ExerciseBlocks` de @cmv/shared) : l'ordre du tableau EST
  /// l'ordre d'affichage. Stocké en JSON et non en tables — aucune requête n'interroge une
  /// cellule, et le snapshot de planification se réduit à la copie du blob.
  blocks       Json  @default("[]")

  documents        ExerciseDocument[]
  tags             ExerciseTag[]
  sessionExercises SessionExercise[]
  // Copies posées dans des planifications (P3) : SetNull → la suppression d'un exercice de la
  // bibliothèque ne casse JAMAIS une planif (l'instance garde son snapshot titre/description).
  scheduledCopies  ScheduledSessionExercise[]

  @@index([coachId])
  @@map("exercise")
}

model ExerciseDocument {
  id          String        @id @default(cuid())
  coachId     String // dénormalisé pour le scope tenant direct
  exerciseId  String
  exercise    Exercise      @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  type        DocumentType
  /// INSTRUCTION = image référencée par un bloc de la consigne (`mediaId`). ATTACHMENT par
  /// défaut : c'est le seul usage qui existait avant la consigne structurée.
  usage       DocumentUsage @default(ATTACHMENT)
  storagePath String? // clé objet S3 (type FILE) — jamais le binaire en BDD
  url         String? // lien externe (type LINK)
  fileName    String? // nom d'affichage (type FILE)
  mimeType    String? // type MIME (type FILE)
  createdAt   DateTime      @default(now())

  @@index([coachId])
  @@index([exerciseId])
  @@map("exercise_document")
}

// Tag libre d'un exercice — remplace `ExerciseCategory` (#162). Pas de table `Tag` canonique :
// un tag n'a ni couleur ni description, seulement un nom. L'autocomplétion se lit d'un
// `SELECT DISTINCT name WHERE coachId`, le renommage d'un `UPDATE … WHERE name` — les deux en
// Prisma pur, sans entité à maintenir ni orphelins à purger.
model ExerciseTag {
  id         String   @id @default(cuid())
  coachId    String // dénormalisé pour le scope tenant direct
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  @@unique([exerciseId, name])
  @@index([coachId])
  @@index([coachId, name]) // autocomplétion et filtre par tag
  @@map("exercise_tag")
}

/// Métrique inventée par le coach — nom, unité libre, type de valeur, et pour une échelle
/// ordonnée ses paliers du plus faible au plus fort. Vit au niveau du COACH et non de l'exercice :
/// une cotation maison sert dans toute la bibliothèque. Les blocs la référencent par
/// `customMetricId` ; la référence n'est pas une clé étrangère puisqu'elle vit dans du JSON, donc
/// une métrique supprimée laisse une colonne orpheline — `validateBlockValues` la signale.
model CustomMetric {
  id        String          @id @default(cuid())
  coachId   String
  coach     User            @relation("CoachMetrics", fields: [coachId], references: [id], onDelete: Cascade)
  label     String
  unit      String?
  valueType MetricValueType
  /// Paliers ordonnés (`OrderedScale`), non nul si et seulement si `valueType` vaut SCALE.
  scale     Json?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([coachId, label])
  @@index([coachId])
  @@map("custom_metric")
}

model Session {
  id        String   @id @default(cuid())
  coachId   String
  coach     User     @relation("CoachSessions", fields: [coachId], references: [id], onDelete: Cascade)
  title     String
  notes     String? // consignes globales — nullable, pas de fallback
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises SessionExercise[]
  // Instances posées dans des planifications (P3) : SetNull, même raison que Exercise.
  instances ScheduledSession[]

  @@index([coachId])
  // Exception au singulier (convention repo) : `session` est déjà pris par la table auth.
  @@map("sessions")
}

model SessionExercise {
  id          String   @id @default(cuid())
  coachId     String // dénormalisé pour le scope tenant direct
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId  String
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  position    Int // ordre dans la séance (0-based)
  /// Le CONTEXTE que la grille ne dit pas — « épaule sensible, reste prudent ». Anciennement
  /// `prescription`, qui portait le dosage écrit à la main : ce rôle revient désormais à `blocks`.
  note        String?
  /// Dosage EFFECTIF de cet exercice dans cette séance — ce que tout le monde lit.
  blocks      Json     @default("[]")
  /// La copie faite à l'AJOUT. Sert à « Tout réinitialiser », et c'est contre elle que le verrou
  /// du niveau séance est vérifié. Elle ne bouge qu'à « Recharger depuis la bibliothèque ».
  baseline    Json     @default("[]")
  /// Les chemins de valeurs touchées et leur niveau (`Adjustments` de @cmv/shared). Le marqueur
  /// hérité/ajusté est ainsi porté par la donnée, jamais déduit d'une comparaison à l'affichage.
  adjustments Json     @default("[]")
  createdAt   DateTime @default(now())

  @@unique([sessionId, position])
  @@index([coachId])
  @@index([exerciseId])
  @@map("session_exercise")
}

// ─────────────────────────────────────────────────────────────────────────────
// Métier — planifications (P3).
// Le Plan est le PREMIER objet lu par les deux rôles : chaque table porte donc `coachId` ET
// `athleteId` en direct (le tenancy extension scope par un champ du modèle lui-même). Le
// scope athlète ne suffit pas à lui seul : un plan DRAFT lui reste invisible grâce au filtre
// `status: PUBLISHED` appliqué par le service athlète — voir PlanService.
//
// Une séance planifiée est une COPIE FIGÉE d'un modèle de séance, pas une référence :
// titre/consignes/exercices (titre, description, catégorie, prescription) et les documents
// sont dupliqués à l'instanciation. Les liens `source*` sont donc nullables (`SetNull`) et ne
// servent qu'à la traçabilité — la bibliothèque du coach reste librement modifiable et
// supprimable sans jamais dégrader une planif déjà diffusée.
//
// Les documents copiés PARTAGENT la clé objet S3 de l'original (aucune duplication de binaire) :
// la suppression d'un document/exercice de la bibliothèque ne purge donc l'objet que s'il n'est
// plus référencé par une copie (garde de comptage côté service).
// ─────────────────────────────────────────────────────────────────────────────

enum PlanStatus {
  DRAFT // en construction — invisible de l'athlète
  PUBLISHED // diffusée — visible de l'athlète, notification envoyée
}

enum PlanWeekType {
  TRAINING
  DELOAD // décharge
}

enum ScheduledSessionStatus {
  PLANNED // posée par le coach (état initial et seul état écrit en P3)
  DONE // transition portée par le débrief (P4)
  SKIPPED
}

model Plan {
  id          String     @id @default(cuid())
  coachId     String
  coach       User       @relation("CoachPlans", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId   String
  athlete     User       @relation("AthletePlans", fields: [athleteId], references: [id], onDelete: Cascade)
  title       String
  description String? // description du cycle — nullable, pas de fallback
  // Date civile (pas d'horaire, pas de fuseau) : toujours un LUNDI (planStartDateSchema).
  // Les dates des semaines s'en déduisent (planWeekRange) — rien n'est stocké sur PlanWeek.
  startDate   DateTime   @db.Date
  status      PlanStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  weeks             PlanWeek[]
  scheduledSessions ScheduledSession[]
  invoice           Invoice? // facturation du cycle (1:1) — DRAFT tant que non diffusé (P6)

  @@index([coachId])
  @@index([athleteId, status]) // lecture athlète : ses plans diffusés
  @@map("plan")
}

model PlanWeek {
  id         String       @id @default(cuid())
  // coachId/athleteId recopiés du Plan parent : l'extension tenant filtre par un champ du
  // modèle INTERROGÉ (`where: { coachId }`), elle ne sait pas remonter la relation
  // (`where: { plan: { coachId } }`). Sans ces colonnes, la semaine serait non scopable.
  // L'extension les injecte elle-même à la création — aucun service ne les renseigne.
  coachId    String
  athleteId  String
  planId     String
  plan       Plan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber Int // 1-based ; nombre de semaines LIBRE (CDC §5.4)
  type       PlanWeekType
  note       String? // note de semaine — nullable
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  sessions ScheduledSession[]

  @@unique([planId, weekNumber])
  @@index([coachId])
  @@index([athleteId])
  @@map("plan_week")
}

model ScheduledSession {
  id              String                 @id @default(cuid())
  coachId         String
  athleteId       String
  planId          String
  plan            Plan                   @relation(fields: [planId], references: [id], onDelete: Cascade)
  planWeekId      String
  planWeek        PlanWeek               @relation(fields: [planWeekId], references: [id], onDelete: Cascade)
  sourceSessionId String? // modèle d'origine — traçabilité seule
  sourceSession   Session?               @relation(fields: [sourceSessionId], references: [id], onDelete: SetNull)
  title           String // copié du modèle, puis éditable
  notes           String? // consignes globales — nullable
  scheduledDate   DateTime               @db.Date // dans la plage de sa semaine (invariant service)
  position        Int // ordre dans la journée (0-based)
  status          ScheduledSessionStatus @default(PLANNED)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  exercises ScheduledSessionExercise[]
  feedback  SessionFeedback? // au plus un débrief par séance (P4)
  messages  Message[] // messages rattachés à cette séance (P5) — SetNull à la suppression

  @@unique([planWeekId, scheduledDate, position]) // plusieurs séances par jour, ordonnées
  @@index([coachId])
  @@index([athleteId, scheduledDate]) // vue semaine / liste des séances de l'athlète
  @@index([planId])
  @@index([sourceSessionId])
  @@map("scheduled_session")
}

model ScheduledSessionExercise {
  id                 String           @id @default(cuid())
  coachId            String
  athleteId          String
  scheduledSessionId String
  scheduledSession   ScheduledSession @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  sourceExerciseId   String? // exercice d'origine — traçabilité seule
  sourceExercise     Exercise?        @relation(fields: [sourceExerciseId], references: [id], onDelete: SetNull)
  title              String // snapshot : l'affichage ne dépend jamais de sourceExercise
  description        String?
  /// Mêmes champs que l'Exercise source, copiés au moment de la diffusion. Sans eux une planif
  /// diffusée se dégraderait : l'athlète verrait le titre mais perdrait consigne et structure.
  instructions       Json?
  blocks             Json             @default("[]")
  /// Le contexte propre à CET athlète. Anciennement `prescription` — même renommage qu'en séance.
  note               String?
  /// La copie reçue à la diffusion, et les ajustements des DEUX niveaux : ceux de la séance
  /// arrivent marqués SESSION, ceux posés pour l'athlète en SCHEDULED.
  baseline           Json             @default("[]")
  adjustments        Json             @default("[]")
  /// Les métriques maison citées par `blocks`, copiées à la diffusion. Sans elles l'athlète ne
  /// verrait qu'un identifiant — `/custom-metrics` est scopé au coach, et faire dépendre la
  /// lecture d'une planif de sa bibliothèque casserait l'autonomie du snapshot.
  customMetrics      Json             @default("[]")
  position           Int // ordre dans la séance (0-based)
  createdAt          DateTime         @default(now())

  documents ScheduledSessionExerciseDocument[]
  tags      ScheduledSessionExerciseTag[]

  @@unique([scheduledSessionId, position])
  @@index([coachId])
  @@index([athleteId])
  @@index([sourceExerciseId])
  @@map("scheduled_session_exercise")
}

model ScheduledSessionExerciseDocument {
  id                         String                   @id @default(cuid())
  coachId                    String
  athleteId                  String // sans cette copie, l'athlète ne pourrait PAS lire les documents
  scheduledSessionExerciseId String
  scheduledSessionExercise   ScheduledSessionExercise @relation(fields: [scheduledSessionExerciseId], references: [id], onDelete: Cascade)
  type                       DocumentType
  /// Copié comme le reste : sans lui, une planif diffusée listerait les images de consigne
  /// parmi les pièces jointes de l'athlète.
  usage                      DocumentUsage            @default(ATTACHMENT)
  storagePath                String? // MÊME clé objet que le document d'origine (type FILE)
  url                        String? // lien externe (type LINK)
  fileName                   String?
  mimeType                   String?
  createdAt                  DateTime                 @default(now())

  @@index([coachId])
  @@index([athleteId])
  @@index([scheduledSessionExerciseId])
  @@index([storagePath]) // garde de comptage avant purge d'un objet S3 encore référencé
  @@map("scheduled_session_exercise_document")
}

// Copie figée des tags au moment de la diffusion — même raison que les documents : l'affichage
// d'une planif ne doit JAMAIS dépendre de l'exercice source, qui peut être retagué ou supprimé.
model ScheduledSessionExerciseTag {
  id                         String                   @id @default(cuid())
  coachId                    String
  athleteId                  String
  scheduledSessionExerciseId String
  scheduledSessionExercise   ScheduledSessionExercise @relation(fields: [scheduledSessionExerciseId], references: [id], onDelete: Cascade)
  name                       String
  createdAt                  DateTime                 @default(now())

  @@unique([scheduledSessionExerciseId, name])
  @@index([coachId])
  @@index([athleteId])
  @@map("scheduled_session_exercise_tag")
}

// ─────────────────────────────────────────────────────────────────────────────
// Métier — débrief & médias (P4).
// Le débrief est écrit par l'ATHLÈTE et lu par le COACH : les deux tables portent donc
// `coachId` ET `athleteId` en direct, comme la planification (le tenancy extension scope par
// un champ du modèle interrogé, il ne remonte pas les relations).
//
// ⚠️ Le scope tenant ne dit rien du STATUT : seul le service impose qu'une séance débriefée
// appartienne à un plan PUBLISHED (un brouillon n'est pas débriefable) — voir FeedbackService.
//
// Contrairement aux documents de la bibliothèque, un média de débrief n'est JAMAIS copié ni
// partagé : sa clé objet n'appartient qu'à lui. Sa suppression purge donc l'objet directement,
// sans garde de comptage (pas de nouveau cas d'orphelin — cf. dettes P2-1/P3-2).
// ─────────────────────────────────────────────────────────────────────────────

enum MediaType {
  IMAGE
  VIDEO
  AUDIO // débrief vocal (P5) — note vocale de l'athlète, m4a
}

model SessionFeedback {
  id                 String           @id @default(cuid())
  coachId            String // dénormalisé : le coach LIT le débrief de son athlète
  coach              User             @relation("CoachFeedback", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId          String
  athlete            User             @relation("AthleteFeedback", fields: [athleteId], references: [id], onDelete: Cascade)
  scheduledSessionId String           @unique // un seul débrief par séance (CDC §5.6)
  scheduledSession   ScheduledSession @relation(fields: [scheduledSessionId], references: [id], onDelete: Cascade)
  content            String? // texte libre — nullable : un débrief peut n'être que des médias
  // Marqueur de lecture du coach : alimente la tuile « Débriefs à relire ». Repassé à null
  // quand l'athlète complète son débrief, sinon un ajout tardif ne serait jamais resignalé.
  coachReadAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  media    FeedbackMedia[]
  messages Message[] // messages rattachés à ce débrief (P5) — SetNull à la suppression

  @@index([coachId, coachReadAt]) // tuile dashboard : les débriefs non lus du coach
  @@index([athleteId])
  @@map("session_feedback")
}

model FeedbackMedia {
  id                String          @id @default(cuid())
  coachId           String
  athleteId         String
  sessionFeedbackId String
  sessionFeedback   SessionFeedback @relation(fields: [sessionFeedbackId], references: [id], onDelete: Cascade)
  type              MediaType
  storagePath       String // clé objet S3 — jamais le binaire en BDD
  fileName          String
  mimeType          String
  sizeBytes         Int
  durationSeconds   Int? // vidéo uniquement — déclaré par le client (pas de décodage serveur)
  createdAt         DateTime        @default(now())

  @@index([coachId])
  @@index([athleteId])
  @@index([sessionFeedbackId])
  @@map("feedback_media")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications push (P4).
// Un token adresse une INSTALLATION de l'app, pas un utilisateur : d'où une table (plusieurs
// appareils par personne) plutôt qu'une colonne sur User. Le token change (réinstallation,
// restauration) → `@unique` pour que le réenregistrement mette à jour la ligne existante.
// Scopé `userId` pour les deux rôles : chacun ne gère que ses propres appareils. L'ENVOI, lui,
// lit les tokens du DESTINATAIRE (un autre tenant) — il passe donc par le client Prisma de
// base, cf. NotificationService.
// ─────────────────────────────────────────────────────────────────────────────

enum PushPlatform {
  IOS
  ANDROID
}

model PushToken {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String       @unique // ExponentPushToken[…] — l'adresse de livraison
  platform  PushPlatform // sans effet sur la livraison (Expo route seul) : diagnostic prod
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@map("push_token")
}

// ─────────────────────────────────────────────────────────────────────────────
// Messagerie (P5) — communication asynchrone coach ↔ athlète (CDC §5.8).
// Fil 1:1 : les DEUX rôles lisent ET écrivent, d'où `coachId` ET `athleteId` en direct sur les
// deux tables (le tenancy extension scope par un champ du modèle interrogé, pas par la relation).
// Un `@@unique([coachId, athleteId])` garantit un seul fil par relation et rend la course du
// get-or-create inoffensive (le 2e create échoue en P2002, on relit).
//
// MVP : asynchrone (polling TanStack Query + push). WebSocket temps réel différé post-MVP.
// ─────────────────────────────────────────────────────────────────────────────

// Un message est SOIT du texte SOIT un média (audio/image/vidéo) — jamais les deux (pas de
// légende sur média en MVP). TEXT n'est donc pas un `MediaType` : enum dédié, découplé du débrief
// (le débrief vocal ajoutera `AUDIO` à `MediaType`, pas ici).
enum MessageType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
}

model Conversation {
  id            String    @id @default(cuid())
  coachId       String
  coach         User      @relation("CoachConversations", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId     String
  athlete       User      @relation("AthleteConversations", fields: [athleteId], references: [id], onDelete: Cascade)
  // Dernier message posté : tri de la liste de conversations du coach, sans agréger les messages.
  // Nullable tant qu'aucun message n'a été envoyé (pas de fallback silencieux).
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  messages Message[]

  @@unique([coachId, athleteId]) // 1:1 par relation ; garde la course du get-or-create
  @@index([coachId])
  @@index([athleteId])
  @@map("conversation")
}

model Message {
  id                 String            @id @default(cuid())
  coachId            String // dénormalisé (scope tenant — un include imbriqué n'est pas scopé)
  athleteId          String // dénormalisé
  conversationId     String
  conversation       Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Auteur du message : coachId ou athleteId. Détermine l'alignement des bulles et le destinataire
  // du push (l'AUTRE partie). Pas de FK relation métier : lu tel quel côté client.
  senderId           String
  sender             User              @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  type               MessageType
  content            String? // texte (type TEXT) — nullable
  // Média (type AUDIO | IMAGE | VIDEO) : clé objet S3 + métadonnées, jamais le binaire en BDD.
  storagePath        String?
  fileName           String?
  mimeType           String?
  sizeBytes          Int?
  durationSeconds    Int? // audio/vidéo — déclaré par le client (pas de décodage serveur)
  // Rattachement optionnel à une séance ou un débrief (« à propos de… »). Nullable/SetNull :
  // supprimer la cible n'efface pas le message, il perd juste son contexte.
  scheduledSessionId String?
  scheduledSession   ScheduledSession? @relation(fields: [scheduledSessionId], references: [id], onDelete: SetNull)
  sessionFeedbackId  String?
  sessionFeedback    SessionFeedback?  @relation(fields: [sessionFeedbackId], references: [id], onDelete: SetNull)
  // Lu par le DESTINATAIRE (pas l'auteur) : alimente `unreadCount` et le throttle push
  // « first-unread » (on ne notifie qu'au passage de « tout lu » à « non lu »).
  readAt             DateTime?
  createdAt          DateTime          @default(now())

  @@index([conversationId, createdAt]) // fil chronologique
  @@index([coachId])
  @@index([athleteId])
  @@index([scheduledSessionId])
  @@index([sessionFeedbackId])
  @@map("message")
}

// ─────────────────────────────────────────────────────────────────────────────
// Facturation (P6) — le coach émet, l'athlète lit (CDC §5.10).
// `coachId` ET `athleteId` en direct (comme la messagerie) : le coach ÉCRIT, l'athlète LIT — le
// tenancy extension scope chaque rôle par un champ du modèle, pas par la relation. La même liste
// sert donc les deux rôles sans requête distincte.
// Statut MANUEL (PENDING/PAID), réversible : le paiement réel est externe (virement) en MVP ; le
// PSP (Stripe) qui poserait ce statut est différé v1.0. `amountCents` = ENTIER de centimes.
// ─────────────────────────────────────────────────────────────────────────────

// Cycle de vie lié à celui du cycle : DRAFT (termes saisis dans le builder, cycle non diffusé,
// invisible de l'athlète) → PENDING (émise au publish) → PAID (marquée réglée, réversible).
enum InvoiceStatus {
  DRAFT
  PENDING
  PAID
  CANCELLED // annulée par le coach depuis PENDING — terminal, le cycle facturé n'est pas affecté
}

model Invoice {
  id                String        @id @default(cuid())
  coachId           String // émetteur
  coach             User          @relation("CoachInvoices", fields: [coachId], references: [id], onDelete: Cascade)
  athleteId         String // destinataire (lecture)
  athlete           User          @relation("AthleteInvoices", fields: [athleteId], references: [id], onDelete: Cascade)
  // Cycle facturé (1:1) — @unique garantit une seule facture par cycle. Nullable pour rester
  // ouvert à une facture hors-cycle (v1.0) ; en MVP toujours renseigné. Cascade : supprimer le
  // cycle supprime sa facture (elle n'a de sens que rattachée).
  planId            String?       @unique
  plan              Plan?         @relation(fields: [planId], references: [id], onDelete: Cascade)
  period            String // mois civil facturé "YYYY-MM" (ex. "2026-07"), dérivé du début du cycle
  amountCents       Int // centimes, jamais un float
  currency          String        @default("EUR") // EUR en MVP ; champ présent pour le multi-devise v1.0
  status            InvoiceStatus @default(DRAFT)
  issuedAt          DateTime? // posé au publish (émission) — null tant que DRAFT
  dueDate           DateTime      @db.Date // échéance, date civile (comme Plan.startDate)
  paidAt            DateTime? // posé au marquage PAID, effacé au retour PENDING — null tant qu'impayée
  note              String?
  // Justificatif PDF (le coach l'envoie aujourd'hui par un autre canal). Clé objet S3 + métadonnées
  // — jamais le binaire en BDD (règle 7). Nullable : facultatif. Un seul PDF par facture.
  documentPath      String?
  documentFileName  String?
  documentMimeType  String?
  documentSizeBytes Int?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([coachId, status]) // tuile « Factures en attente » + liste coach
  @@index([athleteId, status]) // liste athlète
  @@map("invoice")
}

// ─────────────────────────────────────────────────────────────────────────────
// Centre de notifications (#48) — trace PERSISTÉE des événements déjà poussés en push.
// Le push est éphémère : téléphone éteint, permission refusée, ou compte qui n'a jamais ouvert le
// mobile (le coach travaille sur le web). Dans les trois cas il ne restait RIEN à consulter. Cette
// table s'écrit donc aux mêmes points de déclenchement, en plus du push et jamais à sa place.
//
// Le LIBELLÉ n'est pas stocké : une ligne écrite aujourd'hui serait figée en français le jour où
// `en.json` arrive. On persiste les PARAMÈTRES (`actorName`, `subjectLabel`) et le rendu se fait à
// l'affichage, dans la langue courante (cf. `NOTIFICATION_LABEL_KEY` dans @cmv/shared).
//
// Scopée `recipientId` pour les deux rôles (comme PushToken) : chacun ne lit que les siennes.
// L'ÉCRITURE, elle, vise un autre tenant (le coach notifie SON athlète) → client Prisma de base,
// cf. NotificationService.
// ─────────────────────────────────────────────────────────────────────────────

// Les trois façons d'ajuster un cycle diffusé sont distinguées : annoncer « séance modifiée »
// quand elle a été SUPPRIMÉE enverrait l'athlète chercher une séance qui n'existe plus.
enum NotificationType {
  PLAN_PUBLISHED
  PLAN_UPDATED
  PLAN_SESSION_ADDED
  PLAN_SESSION_REMOVED
  FEEDBACK_RECEIVED
  MESSAGE_RECEIVED
  INVOICE_ISSUED
}

// Ce que la notification désigne, pour router à l'ouverture. Aujourd'hui dérivable du `type` — on
// la garde explicite parce que les rappels (#51) casseront cette dérivation : un rappel dû porte
// sur une facture OU une séance, selon ce qu'on rappelle.
enum NotificationEntityType {
  PLAN
  SCHEDULED_SESSION
  CONVERSATION
  INVOICE
}

model Notification {
  id           String                 @id @default(cuid())
  recipientId  String
  recipient    User                   @relation("ReceivedNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type         NotificationType
  entityType   NotificationEntityType
  // Cible polymorphe, donc PAS de FK : le modèle visé dépend de `entityType`. Contrepartie
  // assumée — une cible supprimée laisse une entrée qui mène à un 404 (aucun flux MVP n'y mène :
  // un cycle diffusé ne se supprime plus, une facture émise non plus).
  entityId     String
  // Paramètres d'interpolation du libellé. Nullables : une facture émise n'a ni acteur ni sujet à
  // nommer (règle 5 — null, pas de valeur de repli). Ce sont des INSTANTANÉS : renommer un cycle
  // ne réécrit pas les notifications déjà émises, et c'est voulu.
  actorName    String?
  subjectLabel String?
  // null = non lue. C'est ce qui alimente le badge. Pas d'`updatedAt` sur ce modèle : la table est
  // en ajout seul, et `readAt` EST l'horodatage de sa seule mutation.
  readAt       DateTime?
  createdAt    DateTime               @default(now())

  @@index([recipientId, createdAt(sort: Desc)]) // liste du centre, la plus récente d'abord
  @@index([recipientId, readAt]) // compteur de non-lues (badge)
  @@map("notification")
}

// ─────────────────────────────────────────────────────────────────────────────
// Rappels (#44) — « relancer le renouvellement de ce cycle », « facture en retard ».
//
// Outil PRIVÉ du coach : scopé `coachId` SEUL (pas d'`athleteId`), donc aucun athlète n'en voit
// jamais aucun — contrairement à la planification ou à la facture, qui portent les deux champs.
// C'est la première entité métier du projet à n'avoir qu'un seul rôle lecteur.
//
// Générique par construction (CDC §4 « généricité raisonnable ») : la cible est un couple
// `entityType`/`entityId`, pour couvrir de nouveaux cas d'usage sans migrer le schéma.
//
// Il n'y a PAS de scheduler : « dû » se calcule à la LECTURE (`dueAt <= now`, cf. `isReminderDue`
// dans @cmv/shared), comme le « en retard » d'une facture. Conséquence assumée — un rappel qui
// devient dû n'émet aucun push, il apparaît dans le centre au prochain chargement (#51). C'est
// #47 qui lèvera ce manque, une fois tranché son support d'exécution.
// ─────────────────────────────────────────────────────────────────────────────

// PENDING → DONE | DISMISSED, RÉVERSIBLE dans les deux sens (simple toggle, comme InvoiceStatus
// payé/impayé) : rouvrir un rappel marqué fait par erreur ne doit pas demander d'en recréer un.
// DISMISSED est la suppression douce — il n'y a pas de DELETE sur un rappel, un rappel qu'on a
// renoncé à traiter reste une information.
enum ReminderStatus {
  PENDING
  DONE
  DISMISSED
}

// Volontairement plus étroit que NotificationEntityType, et distinct de lui : ici ce que le produit
// permet de RAPPELER (les deux gestes offerts par l'UI), là ce vers quoi une notification peut
// POINTER (quatre écrans). Le pont vers la navigation est une table de @cmv/shared, pas une fonte
// des deux enums — qui obligerait l'API à refuser CONVERSATION et SCHEDULED_SESSION à la main.
enum ReminderEntityType {
  PLAN
  INVOICE
}

// Pourquoi un rappel a été généré AUTOMATIQUEMENT (#47) ; NULL = saisi par le coach.
// On persiste le MOTIF, jamais son libellé : une note écrite par l'API serait un texte rendu puis
// stocké, ce que le modèle de notification interdit (#48). Le rendu se fait côté client, via
// REMINDER_REASON_KEY (@cmv/shared) — même dispositif que NOTIFICATION_LABEL_KEY.
enum ReminderReason {
  PLAN_ENDING
  INVOICE_OVERDUE
}

model Reminder {
  id         String             @id @default(cuid())
  coachId    String
  coach      User               @relation("CoachReminders", fields: [coachId], references: [id], onDelete: Cascade)
  entityType ReminderEntityType
  // Cible polymorphe, donc PAS de FK — même motif que Notification.entityId (dette N-4) : le modèle
  // visé dépend d'`entityType`. Différence qui compte ici : un cycle DRAFT, lui, SE SUPPRIME
  // vraiment (`DELETE /plans/:id`). Le rappel qui le visait est donc purgé dans la transaction de
  // suppression, plutôt que laissé à pointer vers le vide.
  entityId   String
  // INSTANT, pas une date civile comme Plan.startDate ou Invoice.dueDate : un rappel se déclenche à
  // une heure, et s'affiche dans le fuseau de son lecteur (formatIsoDateTime, jamais formatIsoDate).
  dueAt      DateTime
  // Le contenu du rappel quand c'est le COACH qui l'écrit (comme Plan.title) — pas un libellé
  // système : le stocker ne contredit pas la règle « le libellé d'une notification n'est jamais
  // stocké ». NULL sur un rappel auto-généré (#47), qui porte un `reason` à la place : une note
  // fabriquée par l'API serait précisément le libellé figé en français qu'on s'interdit.
  note       String?
  // NULL = rappel saisi à la main. Les deux champs ne s'excluent pas : le coach peut ajouter sa
  // note à un rappel généré (#105) et se l'approprier — la note l'emporte alors à l'affichage
  // (`reminderLabel`, @cmv/shared).
  reason     ReminderReason?
  // Quand le push « ce rappel est dû » a été émis (#47, dette R-1). NULL = jamais poussé.
  // Ce n'est PAS une notification persistée — l'entrée du centre reste calculée à la lecture, et
  // `REMINDER_DUE` reste absent de NotificationType côté Prisma. C'est un marqueur de LIVRAISON,
  // même famille que readAt : il rend le tick idempotent (deux passages rapprochés ne poussent pas
  // deux fois, un tick manqué rattrape au suivant).
  pushedAt   DateTime?
  status     ReminderStatus     @default(PENDING)
  // « Vu dans le centre de notifications » (#51) — DISTINCT du statut : jeter un œil à un rappel dû
  // ne le traite pas. Sans ce champ, le badge d'un rappel dû ne se viderait jamais et le compteur
  // perdrait toute valeur de signal. Même dédoublement que SessionFeedback.coachReadAt, qui
  // coexiste avec le cycle de vie du débrief.
  readAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  // Idempotence de la GÉNÉRATION (#47) : un seul rappel automatique par (coach, cible, motif).
  // Sans elle, chaque tick recréerait le même rappel — toutes les cinq minutes.
  //
  // Les rappels MANUELS échappent à la contrainte sans qu'on ait à l'écrire : PostgreSQL considère
  // deux NULL comme distincts dans un index unique, et `reason` y est NULL. Le coach peut donc
  // poser autant de rappels qu'il veut sur le même cycle.
  //
  // Conséquence assumée : un rappel généré puis TRAITÉ n'est jamais régénéré, même si la condition
  // persiste (facture toujours impayée le mois suivant). C'est voulu — le coach a tranché, on ne le
  // relance pas.
  @@unique([coachId, entityType, entityId, reason])
  @@index([coachId, status, dueAt]) // liste « mes rappels » + sélection des rappels dus
  @@index([coachId, status, readAt]) // compteur de rappels dus non lus (badge)
  // Purge des rappels d'une cible supprimée : le service filtre par (entityType, entityId).
  @@index([entityType, entityId])
  // Sélection des rappels à POUSSER : dus, non encore poussés (#47).
  @@index([status, dueAt, pushedAt])
  @@map("reminder")
}
