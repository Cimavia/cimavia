{
  "expo": {
    "name": "cimavia",
    "slug": "cimavia",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-localization",
      "expo-notifications",
      "expo-image-picker",
      [
        "expo-audio",
        {
          "microphonePermission": "cimavia utilise le micro pour enregistrer tes messages vocaux."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "412cffac-62a8-432c-9f18-04107c70e2cb"
      }
    }
  }
}
