{
  // Typecheck des parcours Maestro (#638) : du Node, pas de l'app. Ni DOM ni React Native — le
  // seed et le runner parlent à l'API et à `adb`, jamais à un écran.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["e2e", "playwright.config.ts"],
  "exclude": ["node_modules"]
}
