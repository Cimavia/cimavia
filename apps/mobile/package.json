{
  "name": "@cmv/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run --coverage",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "build:preview:android": "eas build --profile preview --platform android",
    "build:preview:ios": "eas build --profile preview --platform ios",
    "build:testflight:ios": "eas build --profile testflight --platform ios --auto-submit",
    "ota:preview": "node scripts/publish-update.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.6",
    "@cmv/shared": "workspace:*",
    "@cmv/tokens": "workspace:*",
    "@expo/dom-webview": "~56.0.6",
    "@expo/metro-runtime": "~56.0.21",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/native": "^7.5.0",
    "@sentry/react-native": "7.11.0",
    "@tanstack/query-async-storage-persister": "5.104.0",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-query-persist-client": "5.104.0",
    "better-auth": "1.7.6",
    "expo": "56.0.22",
    "expo-audio": "~56.0.13",
    "expo-constants": "56.0.26",
    "expo-dev-client": "~56.0.27",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "56.0.7",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-intent-launcher": "~56.0.4",
    "expo-linking": "56.0.18",
    "expo-localization": "~56.0.6",
    "expo-network": "~56.0.5",
    "expo-notifications": "~56.0.25",
    "expo-router": "56.2.21",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.26",
    "expo-status-bar": "56.0.4",
    "expo-updates": "~56.0.27",
    "expo-video": "~56.1.4",
    "i18next": "^26.4.2",
    "nativewind": "4.2.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.6.6",
    "react-native": "0.85.3",
    "react-native-css-interop": "0.2.6",
    "react-native-keyboard-controller": "1.21.6",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.8.3"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@cmv/tsconfig": "workspace:*",
    "@sentry/cli": "2.58.4",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@vitest/coverage-v8": "4.1.11",
    "babel-preset-expo": "56.0.16",
    "jsdom": "30.1.1",
