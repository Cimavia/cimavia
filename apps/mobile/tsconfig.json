{
  "extends": "@cmv/tsconfig/base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@cmv/shared": ["../../packages/shared/src/index.ts"],
      "@cmv/tokens": ["../../packages/tokens/src/index.ts"]
    }
  },
  "include": [
    "app",
    "feature",
    "shared",
    "app.config.ts",
    "global.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  // Le harnais et les tests passent par `tsconfig.test.json`, qui seul leur ouvre la bibliothèque
  // DOM. Les laisser ici les ferait échouer sur `querySelector` — et élargir `lib` pour eux
  // ouvrirait `document` à toute la production, ce que ce tsconfig existe pour empêcher.
  "exclude": ["node_modules", "test", "**/*.test.ts", "**/*.test.tsx"]
}
