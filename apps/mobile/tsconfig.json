{
  "extends": "@cmv/tsconfig/base",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"],
      "@cmv/shared": ["../../packages/shared/src/index.ts"],
      "@cmv/tokens": ["../../packages/tokens/src/index.ts"]
    }
  },
  "include": [
    "app",
    "feature",
    "shared",
    "app.config.ts",
    // Comme côté web : sous `moduleResolution: Bundler`, les types de `vitest/config` se
    // résolvent, donc une propriété inventée y échoue. Ajouté au tsconfig ET vérifié comme tel
    // (leçon de #57 : un typecheck peut être vert sans rien vérifier).
    "vitest.config.ts",
    "global.d.ts",
    "nativewind-env.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules"]
}
