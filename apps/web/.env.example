# URL de l'API NestJS (base du client Better Auth : /api/auth y est ajouté)
VITE_API_URL=http://localhost:3000

# Sentry — remontée des erreurs non maîtrisées. Vide = SDK inerte, l'app démarre pareil.
# ⚠️ Ces deux variables sont FIGÉES AU BUILD (`vite build`) et non lues à l'exécution : c'est la
# nature d'un SPA statique, il faut donc un build par tier (cf. apps/web/Dockerfile).
# Le DSN n'est PAS un secret — il part dans le bundle, n'importe qui peut le lire.
VITE_SENTRY_DSN=

# Le TIER de déploiement (development | staging | production), pas le mode de build.
VITE_APP_ENV=development
