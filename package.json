{
  "name": "cimavia",
  "private": true,
  "version": "1.12.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.34.5"
  },
  "packageManager": "pnpm@10.34.5",
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "turbo run dev --filter=@cmv/api",
    "dev:mobile": "pnpm --filter @cmv/mobile dev",
    "dev:web": "pnpm --filter @cmv/web dev",
    "build:shared": "pnpm --filter @cmv/shared build",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "check:dette": "node scripts/check-dette.mjs",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:lint-rules": "node scripts/check-lint-rules.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "turbo": "2.11.6",
    "typescript": "6.0.3"
  }
}
