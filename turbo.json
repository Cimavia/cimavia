{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      // `^build` : les e2e bootent le vrai AppModule, qui importe @cmv/shared depuis son dist.
      // Sans cette dépendance, une installation `--ignore-scripts` (la CI) casse à l'import et
      // non sur une assertion.
      "dependsOn": ["^build"],
      // JAMAIS de cache ici. Les vraies entrées de cette suite sont un Postgres et un MinIO
      // vivants, plus l'état de la base — rien de tout cela n'entre dans le hash de Turbo. Un
      // cache hit rejouerait « 168 passed » sans exécuter une seule requête : une porte qui
      // affiche vert sans avoir rien vérifié, soit exactement la panne qu'elle doit empêcher.
      // Pas d'`outputs` non plus, bien que la tâche produise `coverage-e2e/` depuis #57 :
      // `outputs` ne sert qu'à restaurer depuis le cache, qui est désactivé ici. Les déclarer
      // laisserait croire que ce rapport peut être rejoué sans exécuter la suite.
      "cache": false
    }
  }
}
