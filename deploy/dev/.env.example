# Modèle d'environnement pour le déploiement DÉVELOPPEMENT (NAS).
# Copier en `.env` À CÔTÉ du docker-compose.yml, sur le NAS (deploy/dev/.env — hors git).
# docker compose lit ce `.env` automatiquement pour interpoler les ${...}.

# ── Tier de déploiement ──────────────────────────────────────────────────────
# Label du tier (tag Sentry + logs). Le NAS est le tier "development". Ne PAS confondre avec
# NODE_ENV : celui-ci est figé à "production" dans le compose (mode runtime d'une image buildée).
APP_ENV=development

# ── Images ───────────────────────────────────────────────────────────────────
# Aucune variable ici : `pull-preview.sh` tire la version promue (tag `preview` sur GHCR) et passe
# API_IMAGE / WEB_IMAGE au compose, épinglées par digest (#266). Des valeurs posées dans ce fichier
# seraient ignorées. L'image web de `preview` est construite avec VITE_API_URL = la variable de dépôt
# DEV_PUBLIC_API_URL, qui doit valoir PUBLIC_API_URL ci-dessous.

# ── Base de données (interne au réseau docker, jamais exposée) ────────────────
POSTGRES_USER=cimavia
# hex (pas base64) : ce mot de passe est injecté dans DATABASE_URL, or base64 peut contenir
# / + = qui casseraient l'URL. Générer : openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=cimavia

# ── Auth (Better Auth) ───────────────────────────────────────────────────────
# ⚠️ Secret DIFFÉRENT de celui de la prod. Générer : openssl rand -base64 32
BETTER_AUTH_SECRET=

# ── Qui peut créer un compte (#263) ──────────────────────────────────────────
# Le compose fixe déjà `invitation` par défaut : ce tier est joignable publiquement, et sa règle
# dure « données synthétiques seulement » ne tient que si un inconnu ne peut pas s'y inscrire.
# Ces deux lignes ne servent donc qu'à ÉLARGIR, jamais à fermer :
# - SIGNUP_MODE=open rouvrirait l'inscription à tout le monde. À ne pas faire sur ce tier.
# - SIGNUP_ALLOWED_EMAILS liste les adresses qui peuvent s'inscrire SANS invitation, séparées par
#   des virgules. C'est la porte des COACHS, que personne n'invite. Les athlètes passent par
#   l'invitation nominative de leur coach — un lien générique ne suffit pas, il n'identifie
#   personne.
# SIGNUP_MODE=invitation
SIGNUP_ALLOWED_EMAILS=

# ── URLs PUBLIQUES = les 3 hostnames du Cloudflare Tunnel ────────────────────
# ⚠️ Sous-domaines MONO-NIVEAU (tiret, pas point) : le SSL gratuit de Cloudflare couvre
# *.example.com mais PAS *.dev.example.com. « api-dev » marche, « api.dev » donnerait une erreur
# de certificat (sauf Advanced Certificate Manager, payant).
# À mapper vers les services internes dans le dashboard Cloudflare Zero Trust :
#   api-dev.<domaine> → http://api:3000   ·   app-dev.<domaine> → http://web:80
#   s3-dev.<domaine>  → http://silo:9000   (minio:9000 marche encore, alias jusqu'à #271)
PUBLIC_API_URL=https://api-dev.example.com
PUBLIC_WEB_URL=https://app-dev.example.com
# ⚠️ URL PUBLIQUE du storage : l'API SIGNE les URLs S3 avec, et c'est le TÉLÉPHONE qui les
# appelle. Un endpoint interne (silo:9000) signerait des URLs injoignables depuis le mobile.
PUBLIC_S3_URL=https://s3-dev.example.com

# ── Object storage (SILO, dans le compose) ───────────────────────────────────
# S3_ENDPOINT et S3_FORCE_PATH_STYLE=true sont fixés par le compose (PUBLIC_S3_URL ci-dessus).
S3_REGION=us-east-1
S3_BUCKET=cimavia-media

# DEUX identités, et c'est le sujet de #267 :
# - le compte ROOT administre le stockage. Il ne sort jamais du NAS : `silo-setup` crée la clé de
#   l'API avec, et `backup.sh` liste le bucket avec. L'API ne le voit pas.
# - la clé de l'API ne peut QUE lire, écrire et supprimer les objets du bucket. C'est elle qui
#   apparaît en clair dans chaque URL signée, donc celle qui peut fuiter.
# Générer les deux secrets : openssl rand -hex 24
S3_ROOT_USER=cimavia
S3_ROOT_PASSWORD=
S3_ACCESS_KEY_ID=cimavia-api
S3_SECRET_ACCESS_KEY=

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token du connecteur : dashboard Cloudflare → Zero Trust → Networks → Tunnels → (ton tunnel)
# → Install connector. C'est la longue chaîne après « --token ».
CLOUDFLARE_TUNNEL_TOKEN=

# ── Observabilité (optionnel — laisser vide désactive proprement) ────────────
SENTRY_DSN=
AXIOM_TOKEN=
AXIOM_DATASET=

# ── Push Expo (optionnel — les push partent sans) ────────────────────────────
EXPO_ACCESS_TOKEN=

# ── Envoi d'e-mails — Scaleway Transactional Email (#269) ────────────────────
# Sans ces lignes, RIEN NE PART : plus de repli sur une boîte locale depuis #269. L'API démarre,
# le reste fonctionne, et chaque tentative est journalisée — jamais silencieuse.
# Le domaine d'envoi doit être vérifié côté Scaleway (SPF, DKIM, DMARC, MX).
SMTP_HOST=smtp.tem.scaleway.com
# 465 = TLS implicite, ce que `MailService` applique sur ce port précis. 587 (STARTTLS) marche
# aussi ; ne pas inventer un autre port, le choix du chiffrement se fait sur ce nombre.
SMTP_PORT=465
# ⚠️ Le login n'est PAS une adresse : c'est l'ID DU PROJET Scaleway (un UUID, Console → Project
# settings). Le mot de passe est la clé SECRÈTE de l'application IAM `cimavia-preview-mail`,
# affichée une seule fois à sa création.
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur. L'adresse doit appartenir au domaine vérifié. Défaut du compose si absent :
# Cimavia <no-reply@cimavia.fr>
MAIL_FROM="Cimavia <no-reply@cimavia.fr>"

# ── Déclencheur des rappels automatiques (#47) ───────────────────────────────
# Secret partagé avec le cron externe (workflow GitHub Actions). Générer avec :
#   openssl rand -hex 32
# La MÊME valeur doit exister dans les secrets Actions du dépôt, sous le nom
# REMINDER_TICK_SECRET. Laissé vide, la route de tick répond 503 : aucun rappel
# n'est généré, aucun push à l'échéance ne part. Le reste de l'API fonctionne.
REMINDER_TICK_SECRET=
